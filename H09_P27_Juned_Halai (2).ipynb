    "## Step 7 — Feature engineering and feature selection plan\n",
    "Create an age-band feature as a simple, explainable derived variable. Keep the original `Age` as well. One-hot encode categorical predictors and select up to 15 features using `SelectKBest`. Crucially, feature selection is placed inside the pipeline so it is fitted on training data only."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "aa31a7c3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Feature engineering: age group as a categorical feature.\n",
    "df[\"Age_Group\"] = pd.cut(\n",
    "    df[\"Age\"],\n",
    "    bins=[0, 18, 35, 50, 65, np.inf],\n",
    "    labels=[\"18_or_under\", \"19_to_35\", \"36_to_50\", \"51_to_65\", \"over_65\"],\n",
    "    include_lowest=True\n",
    ").astype(\"object\")\n",
    "\n",
    "X = df.drop(columns=[TARGET])\n",
    "y = df[TARGET].astype(str)\n",
    "\n",
    "print(\"Target classes:\", sorted(y.unique()))\n",
    "print(\"Predictor columns:\", list(X.columns))\n",
    "display(X.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "863961f5",
   "metadata": {},
   "source": [
    "## Step 8 — Stratified train/test split and preprocessing\n",
    "Use an 80/20 split with `stratify=y` so class proportions are approximately preserved. Numeric features are imputed and scaled; categorical features are imputed and one-hot encoded. All fitted transformations occur inside the pipeline after the split."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5e4540a1",
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.20, random_state=RANDOM_STATE, stratify=y\n",
    ")\n",
    "print(\"Training rows:\", len(X_train))\n",
    "print(\"Testing rows:\", len(X_test))\n",
    "print(\"\\\\nTraining class proportions:\")\n",
    "display(y_train.value_counts(normalize=True).round(3).rename(\"train proportion\").to_frame())\n",
    "print(\"Testing class proportions:\")\n",
    "display(y_test.value_counts(normalize=True).round(3).rename(\"test proportion\").to_frame())\n",
    "\n",
    "numeric_features = X.select_dtypes(include=\"number\").columns.tolist()\n",
    "categorical_features = X.select_dtypes(exclude=\"number\").columns.tolist()\n",
    "\n",
    "numeric_pipe = Pipeline([\n",
    "    (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
    "    (\"scaler\", StandardScaler())\n",
    "])\n",
    "categorical_pipe = Pipeline([\n",
    "    (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
    "    (\"onehot\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False))\n",
    "])\n",
    "preprocessor = ColumnTransformer([\n",
    "    (\"num\", numeric_pipe, numeric_features),\n",
    "    (\"cat\", categorical_pipe, categorical_features)\n",
    "], verbose_feature_names_out=False)\n",
    "\n",
    "def make_knn_pipeline(n_neighbors=5, metric=\"minkowski\", scale_numeric=True, select_features=True, weights=\"uniform\"):\n",
    "    # KNN relies on distances. This standard pipeline scales numeric columns.\n",
    "    steps = [(\"preprocess\", preprocessor)]\n",
    "    if select_features:\n",
    "        steps.append((\"select\", SelectKBest(score_func=f_classif, k=8)))\n",
    "    steps.append((\"knn\", KNeighborsClassifier(\n",
    "        n_neighbors=n_neighbors, metric=metric, weights=weights\n",
    "    )))\n",
    "    return Pipeline(steps)"
   ]
  },

   "metadata": {},
   "outputs": [],
   "source": [
    "results = []\n",
    "f1_by_k = []\n",
    "k_values = [1, 3, 5, 7, 9, 11, 13, 15]\n",
    "for k in k_values:\n",
    "    row, _ = evaluate_pipeline(f\"k={k}, euclidean, scaled\", make_knn_pipeline(n_neighbors=k, metric=\"euclidean\"))\n",
    "    results.append(row)\n",
    "    f1_by_k.append(row[\"F1_macro\"])\n",
    "\n",
    "plt.figure(figsize=(8, 4.5))\n",
    "plt.plot(k_values, f1_by_k, marker=\"o\", linewidth=2)\n",
    "plt.title(\"Macro F1 by Number of Neighbours\")\n",
    "plt.xlabel(\"k (number of neighbours)\")\n",
    "plt.ylabel(\"Macro F1\")\n",
    "plt.xticks(k_values)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "best_k_by_f1 = k_values[int(np.nanargmax(f1_by_k))]\n",
    "print(\"Best k by macro F1 among tested values:\", best_k_by_f1)\n",
    "\n",
    "for metric in [\"euclidean\", \"manhattan\"]:\n",
    "    row, _ = evaluate_pipeline(f\"k={best_k_by_f1}, {metric}, scaled\", make_knn_pipeline(n_neighbors=best_k_by_f1, metric=metric))\n",
    "    results.append(row)\n",
    "\n",
    "# Unscaled comparison: categorical features are encoded, but numeric columns are not standardised.\n",
    "numeric_unscaled_pipe = Pipeline([(\"imputer\", SimpleImputer(strategy=\"median\"))])\n",
    "categorical_unscaled_pipe = Pipeline([\n",
    "    (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
    "    (\"onehot\", OneHotEncoder(handle_unknown=\"ignore\", sparse_output=False))\n",
    "])\n",
    "unscaled_preprocessor = ColumnTransformer([\n",
    "    (\"num\", numeric_unscaled_pipe, numeric_features),\n",
    "    (\"cat\", categorical_unscaled_pipe, categorical_features)\n",
    "], verbose_feature_names_out=False)\n",
    "unscaled_model = Pipeline([\n",
    "    (\"preprocess\", unscaled_preprocessor),\n",
    "    (\"knn\", KNeighborsClassifier(n_neighbors=best_k_by_f1, metric=\"euclidean\"))\n",
    "])\n",
    "unscaled_row, unscaled_pred = evaluate_pipeline(\n",
    "    f\"k={best_k_by_f1}, euclidean, WITHOUT scaling\", unscaled_model\n",
    ")\n",
    "results.append(unscaled_row)\n",
    "\n",
    "results_df = pd.DataFrame(results).drop_duplicates(subset=[\"Setting\"]).reset_index(drop=True)\n",
    "display(results_df.round(4).sort_values([\"Accuracy\", \"F1_macro\"], ascending=False))"

   "source": [
    "## Step 9 — Baseline KNN model\n",
    "Start with the standard KNN setting `n_neighbors=5`. Report accuracy and macro-averaged precision, recall, and F1 because this is a five-class classification task. Also report specificity and multiclass ROC-AUC where calculable."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dd835775",
   "metadata": {},
   "outputs": [],
   "source": [
    "def macro_specificity(y_true, y_pred, labels):\n",
    "    cm = confusion_matrix(y_true, y_pred, labels=labels)\n",
    "    specs = []\n",
    "    for i in range(len(labels)):\n",
    "        tp = cm[i, i]\n",
    "        fn = cm[i, :].sum() - tp\n",
    "        fp = cm[:, i].sum() - tp\n",
    "        tn = cm.sum() - tp - fn - fp\n",
    "        specs.append(tn / (tn + fp) if (tn + fp) else np.nan)\n",
    "    return float(np.nanmean(specs))\n",
    "\n",
    "def evaluate_pipeline(name, pipe, Xtr=X_train, Xte=X_test, ytr=y_train, yte=y_test):\n",
    "    pipe.fit(Xtr, ytr)\n",
    "    pred = pipe.predict(Xte)\n",
    "    labels = sorted(pd.Series(ytr).unique())\n",
    "    try:\n",
    "        prob = pipe.predict_proba(Xte)\n",
    "        auc = roc_auc_score(yte, prob, labels=pipe.named_steps[\"knn\"].classes_, multi_class=\"ovr\", average=\"macro\")\n",
    "    except Exception:\n",
    "        auc = np.nan\n",
    "    return {\n",
    "        \"Setting\": name,\n",
    "        \"Accuracy\": accuracy_score(yte, pred),\n",
    "        \"Precision_macro\": precision_score(yte, pred, average=\"macro\", zero_division=0),\n",
    "        \"Recall_macro\": recall_score(yte, pred, average=\"macro\", zero_division=0),\n",
    "        \"F1_macro\": f1_score(yte, pred, average=\"macro\", zero_division=0),\n",
    "        \"Specificity_macro\": macro_specificity(yte, pred, labels),\n",
    "        \"ROC_AUC_macro_ovr\": auc\n",
    "    }, pred\n",
    "\n",
    "baseline_model = make_knn_pipeline(n_neighbors=5)\n",
    "baseline_result, baseline_pred = evaluate_pipeline(\"Baseline (k=5, Euclidean)\", baseline_model)\n",
    "display(pd.DataFrame([baseline_result]).round(4))\n",
    "print(classification_report(y_test, baseline_pred, zero_division=0))\n",
    "ConfusionMatrixDisplay.from_predictions(y_test, baseline_pred, labels=sorted(y.unique()), xticks_rotation=35, cmap=\"Purples\")\n",
    "plt.title(\"Baseline KNN — Confusion Matrix\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
